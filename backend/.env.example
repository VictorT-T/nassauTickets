# Copie este arquivo para ".env" e ajuste os valores.
# O arquivo .env NUNCA deve ser enviado ao GitHub (o .gitignore do Node já ignora).

PORT=3000

# Banco de dados MySQL 8.0
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_do_mysql
DB_NAME=nassautickets

# Segredo usado para assinar o login (troque por um texto longo e aleatório)
JWT_SECRET=troque-este-texto-por-algo-longo-e-aleatorio

# Endereço(s) do frontend autorizados a chamar a API (separe por vírgula)
CORS_ORIGIN=http://localhost:5173

# true = ignora o horário de expediente (07h às 17h). Útil para testar fora do horário.
# Para a apresentação/produção, use false.
IGNORAR_EXPEDIENTE=true
